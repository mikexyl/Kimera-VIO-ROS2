<launch>
  <arg name="dataset_name" default="Euroc"/>
  <arg name="parallel" default="false" />
  <arg name="use_sim_time" default="true"/>
  <arg name="robot_id" default="0"/>
  <arg name="robot_name" default="na"/>

  <!-- If true, SparkVio will log output of all modules to the
  'log_output_path' location. -->
  <arg name="log_output" default="false"/>
  <arg name="log_output_path"
  default="$(find-pkg-share kimera_vio_ros)/output_logs/"/>


  <!-- If true, SparkVio will enable the LoopClosureDetector module. -->
  <arg name="use_lcd" default="false"/>
  <arg name="bow_batch_size" default="5"/>
  <arg name="bow_skip_num" default="1"/>
  <arg name="publish_vlc_frames" default="true"/>

  <arg name="params_folder" default="$(find-pkg-share kimera_vio_ros)/param/$(var dataset_name)"/>

  <!-- Subscribed Topics -->
  <arg name="topic.left.image"    default="/cam0/image_raw"/>
  <arg name="topic.right.image"   default="/cam1/image_raw"/>
  <arg name="topic.imu.data"      default="/imu0"/>

  <arg name="use_camera_info"     default="false"/>
  <arg name="topic.left.info"     default="/cam0/camera_info"/>
  <arg name="topic.right.info"    default="/cam1/camera_info"/>

  <!-- Frame IDs -->
  <arg name="frame_id.base_link" default="base_link"/>
  <arg name="frame_id.odom"      default="odom"/>
  <arg name="frame_id.map"       default="map"/>
  <arg name="frame_id.world"     default="world"/>

  <!-- General parameters -->
  <arg name="verbosity"    default="0" />
  <!-- Visualize pipeline output in OpenCV. -->
  <!-- Note that this is duplicated from the flags file -->
  <arg name="visualize"    default="false" />
  <arg name="use_rerun_visualizer" default="true"/>
  <arg name="rerun_host" default="rerun+http://127.0.0.1:9876/proxy"/>
  <arg name="rerun_recording_id" default=""/>
  <arg name="rerun_result_dir" default=""/>
  <arg name="mono_depth.scale_alignment_method" default="none"/>
  <arg name="mono_depth.icp_only_da3_overlap_fusion" default="false"/>
  <arg name="mono_depth.visualize_landmark_scale_alignment" default="false"/>
  <arg name="mono_depth.landmark_scale_flatness_radius" default="4"/>
  <arg name="mono_depth.landmark_scale_max_relative_depth_variation" default="0.15"/>
  <arg name="mono_depth.da3_keyframe_selection_method" default="distance"/>
  <arg name="mono_depth.da3_keyframe_skip" default="0"/>
  <arg name="mono_depth.min_keyframe_distance_m" default="1.0"/>
  <arg name="mono_depth.depth_weighting_enabled" default="true"/>
  <arg name="mono_depth.depth_weight_normal_radius" default="2"/>
  <arg name="mono_depth.depth_weight_min" default="0.05"/>
  <arg name="mono_depth.depth_weight_grazing_power" default="1.0"/>
  <arg name="mono_depth.depth_weight_range_ref" default="0.0"/>
  <arg name="mono_depth.depth_weight_range_power" default="2.0"/>
  <arg name="mono_depth.depth_weight_range_min" default="0.05"/>
  <arg name="mono_depth.visualize_weights" default="false"/>
  <arg name="mono_depth.min_confidence" default="1.1"/>
  <arg name="mono_depth.visualize_confidence" default="false"/>
  <arg name="mono_depth.visualization_point_stride" default="4"/>
  <arg name="mono_depth.visualization_max_points_per_keyframe" default="5000"/>
  <arg name="dense_map.voxel_resolution" default="0.3"/>
  <!-- <arg name="rectified"    default="true" /> -->

  <!-- Launch main node  -->
  <node name="kimera_vio_ros" pkg="kimera_vio_ros" exec="stereo_vio_node"
    output="screen" namespace="kimera_vio_ros"
    args="--use_lcd=$(var use_lcd) \
        --flagfile=$(var params_folder)/flags/Mesher.flags \
        --flagfile=$(var params_folder)/flags/VioBackend.flags \
        --flagfile=$(var params_folder)/flags/RegularVioBackend.flags \
        --flagfile=$(var params_folder)/flags/Visualizer3D.flags \
        --logtostderr 1 \
        --colorlogtostderr 1 \
        --log_prefix 1 \
        --v=$(var verbosity) \
        --log_output=$(var log_output) \
        --output_path=$(var log_output_path) \
        --visualize=$(var visualize)">
    <param name="params_folder"  value="$(var params_folder)"/>

    <param name="use_sim_time"      value="$(var use_sim_time)"/>
    <param name="use_lcd"           value="$(var use_lcd)"/>
    <param name="robot_id"          value="$(var robot_id)"/>
    <param name="robot_name"        value="$(var robot_name)"/>
    <param name="bow_batch_size"    value="$(var bow_batch_size)"/>
    <param name="bow_skip_num"      value="$(var bow_skip_num)"/>
    <param name="publish_vlc_frames" value="$(var publish_vlc_frames)"/>
    <param name="use_rerun_visualizer" value="$(var use_rerun_visualizer)"/>
    <param name="rerun_host" value="$(var rerun_host)"/>
    <param name="rerun_recording_id" value="$(var rerun_recording_id)"/>
    <param name="rerun_result_dir" value="$(var rerun_result_dir)"/>
    <param name="mono_depth.scale_alignment_method" value="$(var mono_depth.scale_alignment_method)"/>
    <param name="mono_depth.icp_only_da3_overlap_fusion" value="$(var mono_depth.icp_only_da3_overlap_fusion)"/>
    <param name="mono_depth.visualize_landmark_scale_alignment" value="$(var mono_depth.visualize_landmark_scale_alignment)"/>
    <param name="mono_depth.landmark_scale_flatness_radius" value="$(var mono_depth.landmark_scale_flatness_radius)"/>
    <param name="mono_depth.landmark_scale_max_relative_depth_variation" value="$(var mono_depth.landmark_scale_max_relative_depth_variation)"/>
    <param name="mono_depth.da3_keyframe_selection_method" value="$(var mono_depth.da3_keyframe_selection_method)"/>
    <param name="mono_depth.da3_keyframe_skip" value="$(var mono_depth.da3_keyframe_skip)"/>
    <param name="mono_depth.min_keyframe_distance_m" value="$(var mono_depth.min_keyframe_distance_m)"/>
    <param name="mono_depth.depth_weighting_enabled" value="$(var mono_depth.depth_weighting_enabled)"/>
    <param name="mono_depth.depth_weight_normal_radius" value="$(var mono_depth.depth_weight_normal_radius)"/>
    <param name="mono_depth.depth_weight_min" value="$(var mono_depth.depth_weight_min)"/>
    <param name="mono_depth.depth_weight_grazing_power" value="$(var mono_depth.depth_weight_grazing_power)"/>
    <param name="mono_depth.depth_weight_range_ref" value="$(var mono_depth.depth_weight_range_ref)"/>
    <param name="mono_depth.depth_weight_range_power" value="$(var mono_depth.depth_weight_range_power)"/>
    <param name="mono_depth.depth_weight_range_min" value="$(var mono_depth.depth_weight_range_min)"/>
    <param name="mono_depth.visualize_weights" value="$(var mono_depth.visualize_weights)"/>
    <param name="mono_depth.min_confidence" value="$(var mono_depth.min_confidence)"/>
    <param name="mono_depth.visualize_confidence" value="$(var mono_depth.visualize_confidence)"/>
    <param name="mono_depth.visualization_point_stride" value="$(var mono_depth.visualization_point_stride)"/>
    <param name="mono_depth.visualization_max_points_per_keyframe" value="$(var mono_depth.visualization_max_points_per_keyframe)"/>
    <param name="dense_map.voxel_resolution" value="$(var dense_map.voxel_resolution)"/>

    <!-- Frame IDs for Odometry -->
    <param name="frame_id">
        <param name="base_link" value="$(var frame_id.base_link)"/>
        <param name="odom"      value="$(var frame_id.odom)"/>
        <param name="map"       value="$(var frame_id.map)"/>
        <param name="world"     value="$(var frame_id.world)"/>
    </param>

    <!-- Subscriber topics -->
    <remap from="left/image"        to="$(var topic.left.image)"/>
    <remap from="right/image"       to="$(var topic.right.image)"/>
    <remap from="imu/data"          to="$(var topic.imu.data)"/>

    <param name="use_camera_info"   value="$(var use_camera_info)"/>
    <remap from="left/camera_info"  to="$(var topic.left.info)"/>
    <remap from="right/camera_info" to="$(var topic.right.info)"/>

    <!-- Remap publisher topics -->
    <remap from="odometry"                to="odometry"/>
    <remap from="resiliency"              to="resiliency"/>
    <remap from="imu_bias"                to="imu_bias"/>
    <remap from="optimized_trajectory"    to="optimized_trajectory"/>
    <remap from="pose_graph"              to="pose_graph"/>
    <remap from="pose_graph_incremental"  to="pose_graph_incremental"/>
    <remap from="optimized_odometry"      to="optimized_odometry"/>
    <remap from="bow_query"               to="bow_query"/>
    <remap from="vlc_frames"              to="vlc_frames"/>
    <remap from="vlc_frame_query"         to="vlc_frame_query"/>
    <remap from="mesh"                    to="mesh"/>
    <remap from="frontend_stats"          to="frontend_stats"/>
    <remap from="debug_mesh_img"          to="debug_mesh_img"/>
    <remap from="time_horizon_pointcloud" to="time_horizon_pointcloud"/>

    <!-- Resiliency Thresholds: TODO(Sandro) document -->
    <param name="velocity_det_threshold"  value="0.1"/>
    <param name="position_det_threshold"  value="0.3"/>
    <param name="stereo_ransac_threshold" value="20"/>
    <param name="mono_ransac_threshold"   value="30"/>

    <!-- Load calibration -->
    <!-- <rosparam command="load" file="$(var params_folder)/calibration.yaml"/> -->
  </node>

</launch>
