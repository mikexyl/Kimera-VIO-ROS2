<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>projective_mesher_ros</name>
  <version>0.0.1</version>
  <description>Standalone sparse projective mesher for generic ROS inputs.</description>

  <maintainer email="mikexyl@example.com">Mike Liu</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>aria_viz</depend>
  <depend>libopencv-dev</depend>
  <depend>pcl_msgs</depend>
  <depend>projective_mesher_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
